-f cheader          docs/regs/chip/esp32c6/hpcpu/clint.toml chip/esp32c6/hpcpu/clint_regs.h

# drivers
-f cheader docs/regs/drivers/timg.toml            drivers/timg/timg_regs.h
-f cheader docs/regs/drivers/usb_serial_jtag.toml drivers/usb_serial_jtag/usb_serial_jtag_regs.h
-f cheader docs/regs/drivers/wdt.toml             drivers/wdt/wdt_regs.h
